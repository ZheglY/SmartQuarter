# Go reads process environment; it does not load this file.
APP_ENV=local
GRPC_ADDR=:8082
HTTP_ADDR=:8083
DATABASE_URL=postgres://issue:CHANGE_ME@localhost:15432/issue_db?sslmode=disable
LOG_LEVEL=info

S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=CHANGE_ME_PRIVATE_BUCKET
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false
# Optional: public endpoint used only for browser presigning (MinIO in Docker).
S3_PUBLIC_ENDPOINT=
S3_UPLOAD_URL_TTL=10m
S3_DOWNLOAD_URL_TTL=5m
MAX_UPLOAD_SIZE=10485760

REDIS_ADDR=localhost:16379
REDIS_PASSWORD=
REDIS_DB=0
NOTIFICATION_STREAM=stream:notifications
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=1s
MAX_PAGE_SIZE=100
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
