# Loaded by the shell or docker compose, not automatically by Go.
APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info
REDIS_ADDR=localhost:16379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_TTL=12h
SESSION_COOKIE_NAME=sq_session
MAX_INIT_DATA_TTL=5m
IDENTITY_GRPC_ADDR=localhost:15051
ISSUE_GRPC_ADDR=localhost:18082
ISSUE_READY_URL=http://localhost:18083/readyz
COMMUNITY_GRPC_ADDR=localhost:19090
COMMUNITY_READY_URL=http://localhost:18084/readyz
GRPC_DIAL_TIMEOUT=5s
GRPC_REQUEST_TIMEOUT=10s
MAX_BOT_TOKEN=
MAX_BOT_API_BASE_URL=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=
MAX_BOT_USERNAME=
# Register this HTTPS application URL in the MAX bot settings.
MAX_MINIAPP_URL=https://app.example.com
NOTIFICATION_STREAM=stream:notifications
NOTIFICATION_CONSUMER_GROUP=max-gateway
TRUSTED_ORIGINS=https://app.example.com
AUTH_RATE_PER_MINUTE=20
BUSINESS_RATE_PER_MINUTE=120
WEBHOOK_RATE_PER_MINUTE=600
NOTIFICATION_RATE_PER_SECOND=2
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
GRACEFUL_SHUTDOWN_TIMEOUT=20s
