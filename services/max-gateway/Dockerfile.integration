FROM golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195 AS build
WORKDIR /src
ENV GOWORK=off CGO_ENABLED=0 GOMAXPROCS=2
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go test -p=2 -mod=readonly -tags=integration -c -o /acceptance ./tests/integration
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /acceptance /acceptance
USER 65532:65532
ENTRYPOINT ["/acceptance", "-test.v", "-test.timeout=180s"]
