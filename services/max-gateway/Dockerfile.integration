FROM golang:1.26.5-bookworm@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd AS build
WORKDIR /src
ENV GOWORK=off CGO_ENABLED=0 GOMAXPROCS=2
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go test -p=2 -mod=readonly -tags=integration -c -o /acceptance ./tests/integration

# Optional submission runner: production images and the default test binary remain unchanged.
FROM python:3.13-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26 AS submission
RUN pip install --no-cache-dir PyYAML==6.0.3 jsonschema==4.26.0
COPY --from=build /acceptance /acceptance
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65532:65532
ENTRYPOINT ["/acceptance", "-test.v", "-test.timeout=180s"]

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /acceptance /acceptance
USER 65532:65532
ENTRYPOINT ["/acceptance", "-test.v", "-test.timeout=180s"]
