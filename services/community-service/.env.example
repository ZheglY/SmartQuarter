# Настройки HTTP и gRPC
HTTP_ADDR=:8084
APP_PORT=8084
GRPC_PORT=9090

# Настройки PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=community_db
DB_PORT=5432

# Настройки Redis
REDIS_PORT=6379

# Строки подключения для микросервиса
DATABASE_URL=postgres://postgres:postgres@community_postgres:5432/community_db?sslmode=disable
REDIS_URL=redis://community_redis:6379/0
