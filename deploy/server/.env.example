# Copy to .env (gitignored). Hex passwords avoid URI escaping issues.
APP_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
IDENTITY_DB_PASSWORD=
ISSUE_DB_PASSWORD=
COMMUNITY_DB_PASSWORD=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_BOT_USERNAME=
# Ubuntu CA bundle, including certificates required by MAX; mounted read-only.
MAX_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
S3_ENDPOINT=https://storage.yandexcloud.net
S3_PUBLIC_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Internal user UUIDs of platform admins: manage chairmen and approve house registrations.
ADMIN_USER_IDS=
