# Public browser configuration only. Never add server credentials here.
VITE_API_BASE_URL=
# Exact S3 origins, comma-separated. No wildcard; match Gateway presigned URLs.
VITE_S3_ORIGINS=https://storage.yandexcloud.net,http://localhost:19000
# Development proxy only; not included in browser bundle.
GATEWAY_PROXY_TARGET=http://127.0.0.1:18080
